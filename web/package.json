    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,cjs,html}\""
  },
  "dependencies": {
    "lucide-react": "1.80.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.7.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8"
  }
